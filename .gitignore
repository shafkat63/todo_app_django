# Django .gitignore file

# Python bytecode files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Python distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/

# Django migrations (optional, uncomment if you want to ignore migrations)
# */migrations/*.py
# !*/migrations/__init__.py

# Virtual Environment
venv/
env/
ENV/
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# PyCharm / VSCode / IDE files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
*.sublime-project
*.sublime-workspace

# Coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Project specific files/folders
staticfiles/
media/
secrets.json
prod_settings.py

# Local development specific files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*